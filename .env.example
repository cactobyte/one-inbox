# Neon Postgres connection string. Use the pooled connection string from the
# Neon dashboard (it contains "-pooler"). Required to run migrations and to
# start the app.
DATABASE_URL=

# Secret used to sign / identify agent sessions and email-verification links.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Transactional email (signup verification). Resend is called over its REST
# API — no SDK. Leave both blank in local dev / previews: the email is written
# to the server log instead of sent, so the flow still works end to end.
RESEND_API_KEY=
EMAIL_FROM=

# Optional. The public origin used to build links in emails. If unset it is
# derived from the request's forwarded host headers (correct on Vercel,
# including previews). Set it only for a stable custom domain.
APP_URL=
